
APP_DB_NAME=fletes
APP_DB_USER=fletes
APP_DB_PASSWORD=cambiar
APP_DB_HOST=localhost
APP_DB_PORT=5433

# Django
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# uid/gid del host para los bind mounts de dev (api y web). En prod no se usan: las
# imágenes traen su propio usuario y no hay bind mount del código.
DOCKER_UID=1000
DOCKER_GID=1000

# Sesión y CSRF
# CSRF_TRUSTED_ORIGINS va con esquema, no sólo el host.
CSRF_TRUSTED_ORIGINS=http://localhost
SESSION_COOKIE_AGE=28800
# Con True sobre HTTP puro el browser nunca guarda la sessionid y el login falla sin un
# solo error. Pasa a True recién cuando haya TLS.
SESSION_COOKIE_SECURE=False

# Header X-API-Key para POST /api/v1/tickets/ingest. Sin valor, el endpoint rechaza todo.
INGEST_API_KEY=cambiar

# Zona cuya medianoche cuenta los dias de estadia (almacenamiento en UTC)
TZ_OPERACION=America/Argentina/Buenos_Aires

# OpenRouteService. Sin la key, la geolocalización se degrada en vez de caerse.
ORS_API_KEY=
ORS_SNAP_RADIUS_M=3000

# SAP
SAP_ENDPOINT=
SAP_USERNAME=
SAP_PASSWORD=

# Gunicorn (sólo prod). Worker sync; el timeout alto es por el I/O contra ORS y SAP.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
PROXY_PORT=80

# Opcionales, con default en settings.py
# STATIC_ROOT=/app/staticfiles
# CONN_MAX_AGE=60
# SQL_LOG_LEVEL=WARNING
